# Store uploads and listing management for Bibless.
# Listings live in fastlane/metadata/{android,ios} and fastlane/screenshots/ios.

ANDROID_AABS = [
  "app/androidApp/build/outputs/bundle/release/androidApp-release.aab",
  "app/wearApp/build/outputs/bundle/release/wearApp-release.aab",
].map { |p| File.expand_path("../#{p}", __dir__) }

# Play track releases go to: closed testing ("alpha"; the Wear OS bundle to "wear:alpha", which exists
# once closed testing is set up for the Wear OS form factor in Play Console).
# The listing sync attaches to the newest release on the same track.
PLAY_TRACK = "alpha"

# The version codes on a Play track. Fails with the names of the tracks Google Play has if there is
# no such track: form factor tracks only exist once they are set up in Play Console.
def play_track_version_codes(track)
  codes = begin
    google_play_track_version_codes(track: track)
  rescue StandardError
    nil
  end
  # google_play_track_version_codes has set up Supply.config with the package and credentials
  client = Supply::Client.make_from_config
  client.begin_edit(package_name: Supply.config[:package_name])
  tracks = client.tracks.map(&:track)
  client.abort_current_edit
  UI.user_error!("Google Play has no track '#{track}'. Its tracks: #{tracks.sort.join(", ")}") unless tracks.include?(track)
  codes || google_play_track_version_codes(track: track)
end

platform :android do
  desc "Capture the Play phone and Wear OS screenshots with Robolectric and Roborazzi (demo data, see ScreenshotTest); " \
       "no emulator needed"
  lane :screenshots do
    # The ScreenshotTests write straight into fastlane/metadata/android/en-US/images (see the
    # storeScreenshots property in the apps' build.gradle.kts), under fixed names
    # --tests filters the task before it, so each test task gets its own
    gradle(
      task: %w[androidApp wearApp].map { |m| ":app:#{m}:testDebugUnitTest --tests '*.ScreenshotTest'" }.join(" "),
      flags: "-PstoreScreenshots"
    )
  end

  desc "Upload one bundle to a Play track: form:phone or form:wear (to the Wear OS form factor's track), " \
       "version_code:<the bundle's code>. Skips a bundle the track already has, so a failed release can be re-run"
  lane :upload do |options|
    phone_aab, wear_aab = ANDROID_AABS
    aab, track = case options[:form]
                 when "phone" then [phone_aab, options[:track] || PLAY_TRACK]
                 # Wear OS bundles go to the Wear OS form factor tracks (Advanced settings → Form factors)
                 when "wear" then [wear_aab, "wear:#{options[:track] || PLAY_TRACK}"]
                 else UI.user_error!("Pass form:phone or form:wear")
                 end
    version_code = Integer(options[:version_code] || UI.user_error!("Pass version_code:<the bundle's code>"))

    if play_track_version_codes(track).include?(version_code)
      UI.success("#{track} already has #{version_code}, skipping the upload")
      next
    end
    upload_to_play_store(
      track: track,
      aab: aab,
      metadata_path: "fastlane/metadata/android",
      release_status: options[:release_status] || "completed",
      # The listing and its screenshots are synced by the metadata lane, after both bundles
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Release both bundles to the Play track, then the listing with fresh screenshots: " \
       "version_code_phone:<code> version_code_wear:<code>. The Play edits run one after another, " \
       "since Google Play allows one at a time"
  lane :release do |options|
    screenshots
    upload(form: "phone", version_code: options.fetch(:version_code_phone))
    upload(form: "wear", version_code: options.fetch(:version_code_wear))
    metadata
  end

  desc "Sync the Play store listing (texts, images) without uploading a binary"
  lane :metadata do
    # supply attaches the listing to an existing release; production stays empty until the first public release
    track = PLAY_TRACK
    upload_to_play_store(
      metadata_path: "fastlane/metadata/android",
      track: track,
      version_code: google_play_track_version_codes(track: track).max,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )
  end
end

IOS_APP_ID = "com.github.nols1000.bibless"
WATCH_APP_ID = "#{IOS_APP_ID}.watchkitapp"
WIDGET_APP_ID = "#{WATCH_APP_ID}.widget"
PHONE_WIDGET_APP_ID = "#{IOS_APP_ID}.widget"
XCODE_PROJECT = "app/iosApp/iosApp.xcodeproj"
# Encrypted certificates/profiles; CI authenticates with the MATCH_DEPLOY_KEY deploy key
MATCH_GIT_URL = "git@github.com:Nols1000/bibless-certificates.git"

platform :ios do
  before_all do |lane|
    next if lane == :screenshots # runs locally on simulators, no App Store Connect access needed

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  desc "Build the iOS app (with embedded watchOS app) and upload it to TestFlight"
  lane :beta do |options|
    build_ipa(options)
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build and upload to TestFlight, then sync the listing with fresh screenshots: " \
       "version:<x.y.z> build_number:<n>"
  lane :release do |options|
    screenshots
    beta(options)
    metadata
  end

  # Each app shares the app group group.com.github.nols1000.bibless with its widget (see the
  # entitlements in app/iosApp/Configuration). App groups can't be set up through the API: create
  # the group in the Developer Portal, enable it on all four ids, then run the certificates lane with force:true.
  desc "Register the app, watch app and widget bundle ids in the Developer Portal if missing"
  lane :register_app_ids do
    {
      IOS_APP_ID => "Bibless",
      WATCH_APP_ID => "Bibless Watch App",
      WIDGET_APP_ID => "Bibless Watch Widget",
      PHONE_WIDGET_APP_ID => "Bibless Widget",
    }.each do |identifier, name|
      next if Spaceship::ConnectAPI::BundleId.find(identifier)

      UI.message("Registering bundle id #{identifier}")
      Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
    end
  end

  desc "Fetch (or on first run create) the App Store certificate and profiles via match. " \
       "force:true regenerates the profiles, e.g. after changing an app id's capabilities " \
       "(bundle exec fastlane ios certificates force:true)"
  lane :certificates do |options|
    setup_ci # temporary keychain on CI runners; does nothing locally
    register_app_ids unless options[:readonly]
    match(
      type: "appstore",
      app_identifier: [IOS_APP_ID, WATCH_APP_ID, WIDGET_APP_ID, PHONE_WIDGET_APP_ID],
      git_url: MATCH_GIT_URL,
      readonly: options.fetch(:readonly, false),
      force: options.fetch(:force, false)
    )
  end

  desc "Build a signed App Store IPA (with embedded watchOS app) into build/ios"
  lane :build_ipa do |options|
    certificates
    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    # Switch the targets to manual signing with the match profiles (runner-local change only)
    {
      "iosApp" => IOS_APP_ID,
      "watchApp" => WATCH_APP_ID,
      "watchWidget" => WIDGET_APP_ID,
      "phoneWidget" => PHONE_WIDGET_APP_ID,
    }.each do |target, bundle_id|
      update_code_signing_settings(
        path: XCODE_PROJECT,
        targets: [target],
        use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        profile_name: profiles.fetch(bundle_id),
        bundle_identifier: bundle_id
      )
    end

    build_app(
      project: XCODE_PROJECT,
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: { signingStyle: "manual", provisioningProfiles: profiles },
      output_directory: "build/ios",
      xcargs: [
        "MARKETING_VERSION=#{options.fetch(:version)}",
        "CURRENT_PROJECT_VERSION=#{options.fetch(:build_number)}",
      ].join(" ")
    )
  end

  desc "Capture the App Store iPhone and Apple Watch screenshots on simulators (demo data, see ScreenshotTests)"
  lane :screenshots do
    common = {
      project: XCODE_PROJECT,
      languages: ["en-US"],
      output_directory: "fastlane/screenshots/ios",
      skip_open_summary: true,
      stop_after_first_error: true
    }
    # iPhone 6.9" slot (1320x2868); status bar overridden to 9:41 with full signal and battery
    capture_ios_screenshots(**common, scheme: "iosApp", only_testing: ["iosAppUITests/ScreenshotTests"],
                            devices: ["iPhone 17 Pro Max"], override_status_bar: true,
                            clear_previous_screenshots: true)
    # Apple Watch Ultra slot (422x514)
    capture_ios_screenshots(**common, scheme: "watchApp", only_testing: ["watchAppUITests"],
                            devices: ["Apple Watch Ultra 3 (49mm)"])
  end

  desc "Sync the App Store listing (texts, screenshots) without uploading a binary"
  lane :metadata do
    upload_to_app_store(
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots/ios",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
