# Store uploads and listing management for Bibless.
# Listings live in fastlane/metadata/{android,ios} and fastlane/screenshots/ios.

ANDROID_AABS = [
  "app/androidApp/build/outputs/bundle/release/androidApp-release.aab",
  "app/wearApp/build/outputs/bundle/release/wearApp-release.aab",
].map { |p| File.expand_path("../#{p}", __dir__) }

ANDROID_TEST_PACKAGE = "com.github.nols1000.bibless.test"

platform :android do
  desc "Capture the Play phone and Wear OS screenshots on running emulators (demo data, see ScreenshotTest). " \
       "Options: phone:<adb serial>, wear:<adb serial>; omit one to skip it"
  lane :screenshots do |options|
    targets = { "androidApp" => ["phone", options[:phone]], "wearApp" => ["wear", options[:wear]] }
      .select { |_, (_, serial)| serial }
    UI.user_error!("Pass phone:<serial> and/or wear:<serial> (see `adb devices`)") if targets.empty?

    gradle(tasks: targets.keys.flat_map { |m| [":app:#{m}:assembleDebug", ":app:#{m}:assembleDebugAndroidTest"] })
    targets.each do |mod, (device_type, serial)|
      capture_android_screenshots(
        app_apk_path: "app/#{mod}/build/outputs/apk/debug/#{mod}-debug.apk",
        tests_apk_path: "app/#{mod}/build/outputs/apk/androidTest/debug/#{mod}-debug-androidTest.apk",
        app_package_name: "com.github.nols1000.bibless",
        tests_package_name: ANDROID_TEST_PACKAGE,
        test_instrumentation_runner: "androidx.test.runner.AndroidJUnitRunner",
        specific_device: serial,
        device_type: device_type,
        locales: ["en-US"],
        output_directory: "fastlane/metadata/android",
        clear_previous_screenshots: true,
        exit_on_test_failure: true
      )
    end
  end

  desc "Upload the phone and Wear OS bundles (plus listing) to a Play track"
  lane :upload do |options|
    track = options[:track] || "internal"
    phone_aab, wear_aab = ANDROID_AABS
    common = {
      metadata_path: "fastlane/metadata/android",
      release_status: options[:release_status] || "completed",
      # The listing and its screenshots are synced by the metadata lane (store-metadata.yml)
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    }
    upload_to_play_store(**common, track: track, aab: phone_aab)
    # Wear OS bundles go to the Wear OS form factor tracks (Advanced settings → Form factors)
    upload_to_play_store(**common, track: "wear:#{track}", aab: wear_aab)
  end

  desc "Sync the Play store listing (texts, images) without uploading a binary"
  lane :metadata do
    upload_to_play_store(
      metadata_path: "fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )
  end
end

IOS_APP_ID = "com.github.nols1000.bibless"
WATCH_APP_ID = "#{IOS_APP_ID}.watchkitapp"
XCODE_PROJECT = "app/iosApp/iosApp.xcodeproj"
# Encrypted certificates/profiles; CI authenticates with the MATCH_DEPLOY_KEY deploy key
MATCH_GIT_URL = "git@github.com:Nols1000/bibless-certificates.git"

platform :ios do
  before_all do |lane|
    next if lane == :screenshots # runs locally on simulators, no App Store Connect access needed

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  desc "Build the iOS app (with embedded watchOS app) and upload it to TestFlight"
  lane :beta do |options|
    build_ipa(options)
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Register the app and watch app bundle ids in the Developer Portal if missing"
  lane :register_app_ids do
    { IOS_APP_ID => "Bibless", WATCH_APP_ID => "Bibless Watch App" }.each do |identifier, name|
      next if Spaceship::ConnectAPI::BundleId.find(identifier)

      UI.message("Registering bundle id #{identifier}")
      Spaceship::ConnectAPI::BundleId.create(name: name, platform: "IOS", identifier: identifier)
    end
  end

  desc "Fetch (or on first run create) the App Store certificate and profiles via match"
  lane :certificates do |options|
    register_app_ids unless options[:readonly]
    match(
      type: "appstore",
      app_identifier: [IOS_APP_ID, WATCH_APP_ID],
      git_url: MATCH_GIT_URL,
      readonly: options.fetch(:readonly, false)
    )
  end

  desc "Build a signed App Store IPA (with embedded watchOS app) into build/ios"
  lane :build_ipa do |options|
    setup_ci # temporary keychain on CI runners
    certificates
    profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    # Switch the targets to manual signing with the match profiles (runner-local change only)
    { "iosApp" => IOS_APP_ID, "watchApp" => WATCH_APP_ID }.each do |target, bundle_id|
      update_code_signing_settings(
        path: XCODE_PROJECT,
        targets: [target],
        use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        code_sign_identity: "Apple Distribution",
        profile_name: profiles.fetch(bundle_id),
        bundle_identifier: bundle_id
      )
    end

    build_app(
      project: XCODE_PROJECT,
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: { signingStyle: "manual", provisioningProfiles: profiles },
      output_directory: "build/ios",
      xcargs: [
        "MARKETING_VERSION=#{options.fetch(:version)}",
        "CURRENT_PROJECT_VERSION=#{options.fetch(:build_number)}",
      ].join(" ")
    )
  end

  desc "Capture the App Store iPhone and Apple Watch screenshots on simulators (demo data, see ScreenshotTests)"
  lane :screenshots do
    common = {
      project: XCODE_PROJECT,
      languages: ["en-US"],
      output_directory: "fastlane/screenshots/ios",
      skip_open_summary: true,
      stop_after_first_error: true
    }
    # iPhone 6.9" slot (1320x2868); status bar overridden to 9:41 with full signal and battery
    capture_ios_screenshots(**common, scheme: "iosApp", only_testing: ["iosAppUITests"],
                            devices: ["iPhone 17 Pro Max"], override_status_bar: true,
                            clear_previous_screenshots: true)
    # Apple Watch Ultra slot (422x514)
    capture_ios_screenshots(**common, scheme: "watchApp", only_testing: ["watchAppUITests"],
                            devices: ["Apple Watch Ultra 3 (49mm)"])
  end

  desc "Sync the App Store listing (texts, screenshots) without uploading a binary"
  lane :metadata do
    upload_to_app_store(
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots/ios",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
