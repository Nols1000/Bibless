# Store uploads and listing management for Bibless.
# Listings live in fastlane/metadata/{android,ios} and fastlane/screenshots/ios.

ANDROID_AABS = [
  "app/androidApp/build/outputs/bundle/release/androidApp-release.aab",
  "app/wearApp/build/outputs/bundle/release/wearApp-release.aab",
].map { |p| File.expand_path("../#{p}", __dir__) }

platform :android do
  desc "Upload the phone and Wear OS bundles (plus listing) to a Play track"
  lane :upload do |options|
    upload_to_play_store(
      track: options[:track] || "internal",
      aab_paths: ANDROID_AABS,
      metadata_path: "fastlane/metadata/android",
      release_status: options[:release_status] || "completed"
    )
  end

  desc "Sync the Play store listing (texts, images) without uploading a binary"
  lane :metadata do
    upload_to_play_store(
      metadata_path: "fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )
  end
end

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  desc "Build the iOS app (with embedded watchOS app) and upload it to TestFlight"
  lane :beta do |options|
    build_ipa(options)
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build a signed App Store IPA (with embedded watchOS app) into build/ios"
  lane :build_ipa do |options|
    # Xcode downloads cloud-managed profiles here but doesn't create the folder on fresh CI runners
    FileUtils.mkdir_p(File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles"))

    key_path = File.expand_path("AuthKey.p8", ENV.fetch("RUNNER_TEMP", Dir.tmpdir))
    File.binwrite(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))

    build_app(
      project: "app/iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      # Cloud-managed signing: Xcode fetches certificates/profiles via the API key
      export_options: { signingStyle: "automatic", teamID: ENV.fetch("APPLE_TEAM_ID") },
      output_directory: "build/ios",
      xcargs: [
        "TEAM_ID=#{ENV.fetch('APPLE_TEAM_ID')}",
        "MARKETING_VERSION=#{options.fetch(:version)}",
        "CURRENT_PROJECT_VERSION=#{options.fetch(:build_number)}",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" "),
      export_xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      ].join(" ")
    )
  end

  desc "Sync the App Store listing (texts, screenshots) without uploading a binary"
  lane :metadata do
    upload_to_app_store(
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots/ios",
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
